cat > .env.example << 'EOF'
PORT=3000
# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=replace_with_a_generated_secret
# Public URL of the app (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000
# Brevo transactional email (leave blank locally: emails print to the server console)
BREVO_API_KEY=
EMAIL_FROM=
# Set to true to create demo accounts on startup
SEED_DEMO_DATA=false
EOF